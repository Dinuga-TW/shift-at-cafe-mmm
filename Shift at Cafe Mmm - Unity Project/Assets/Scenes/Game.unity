      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"o_SpeakerNames
      ","value":{"$content":["Customer","YOU","Customer","YOU","Customer","YOU","Customer"],"$type":"System.Collections.Generic.List`1[[System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089]]"},"typeHandle":{"Identification":"System.Collections.Generic.List`1[[System.String,
