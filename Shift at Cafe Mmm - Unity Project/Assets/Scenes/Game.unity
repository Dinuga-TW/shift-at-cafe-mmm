    _json: '{"declarations":{"Kind":"Object","collection":{"$content":[{"name":"o_CharacterID","value":{"$content":0,"$type":"System.Int32"},"typeHandle":{"Identification":"System.Int32,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"o_DialogueLines
      ","value":{"$content":["Hi there! Beautiful sunset tonight, isn''t it?","It
      really is! What can I get for you this evening?","I''d like two colas, please.","Two
      colas coming up. Would you like anything to eat with that?","No thanks, just
      had a late lunch meeting. The drinks are perfect for now.","Sounds good. Two
      colas it is.","The evening light here is so relaxing after a hectic day."],"$type":"System.Collections.Generic.List`1[[System.String,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089]]"},"typeHandle":{"Identification":"System.Collections.Generic.List`1[[System.String,
