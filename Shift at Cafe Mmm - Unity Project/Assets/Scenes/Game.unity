  _data:
    _json: '{"declarations":{"Kind":"Object","collection":{"$content":[{"name":"o_DialogueLines
      ","value":{"$content":["Hey! Just finished my final exam!","Congratulations!
      What can I get for you to celebrate?","I''m starving after all that studying.
      Can I get two burgers?","Two burgers. Would you like any drinks with that?","Nope.
      Spent my coffee budget on energy drinks during exam week.","I remember those
      days! Two burgers coming up.","Thanks! Now I can finally relax and binge-watch
      some shows."],"$type":"System.Collections.Generic.List`1[[System.String, mscorlib,
      Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089]]"},"typeHandle":{"Identification":"System.Collections.Generic.List`1[[System.String,
